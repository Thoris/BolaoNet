@model BolaoNet.MVC.ViewModels.Pagamentos.PagamentoDetailViewModel
@{
    ViewBag.Title = "Pagamentos do Bolão";
}
@*<div class="wrapper wrapper-content animated fadeInRight">*@
    <div class="row">

        <div class="col-lg-8">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h3>Premiação</h3>
                </div>
                <div class="ibox-content" style="display: block;">                    
                    <div class="row">
                        <div class="col-xs-12">
                            <table class="table table-hover" width="100%">
                                <thead>
                                    <tr> 
                                        <td>@Html.DisplayNameFor(model => model.CalculoPremios[0].Colocacao)</td>
                                        <td>@Html.DisplayNameFor(model => model.CalculoPremios[0].Percentage)</td>
                                        <td>@Html.DisplayNameFor(model => model.CalculoPremios[0].ValorPremiacao)</td>  
                                    </tr>
                                </thead>
                                 <tbody>
                                     @for (int c = 0; c < Model.CalculoPremios.Count; c++)
                                     {
                                         <tr> 
                                             <td>@Html.DisplayFor(model => model.CalculoPremios[c].Colocacao)</td>
                                             <td>@Html.DisplayFor(model => model.CalculoPremios[c].Percentage)</td>
                                             <td>@Html.DisplayFor(model => model.CalculoPremios[c].ValorPremiacao)</td>                                               
                                         </tr>
                                     }
                                 </tbody>
                            </table>
                        </div>
                    </div>
                </div>
             </div>
        </div>

        
        <div class="col-lg-4">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h3>Premiação</h3>
                </div>
                <div class="ibox-content" style="display: block;">
                    <div class="row">
                        <div class="col-xs-12">
                            <table class="table table-hover" width="100%">
                                <thead>
                                    <tr>
                                        <td>@Html.DisplayNameFor(model => model.ResponsaveisValores[0].Responsavel)</td>
                                        <td>@Html.DisplayNameFor(model => model.ResponsaveisValores[0].Valor)</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int c = 0; c < Model.ResponsaveisValores.Count; c++)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(model => model.ResponsaveisValores[c].Responsavel)</td>
                                            <td>@Html.DisplayFor(model => model.ResponsaveisValores[c].Valor)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="col-xs-12">
                            <div>
                                Total Pagamentos: @Html.DisplayFor(model => model.TotalPagamentos)
                            </div>
                            <div>
                                Total Arrecadado: @Html.DisplayFor(model => model.ValorTotal)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h3>Pagamentos Efetuados</h3>
                </div>
                <div class="ibox-content" style="display: block;">

                    <div class="row">
                        <div class="col-xs-2">
                            <div class="form-group">

                                <a href="@Url.Action("Create")" class="btn btn-default btn-sm center-block">Criar Novo</a>
                                
                            </div>
                        </div> 
                    </div>

                    <div class="row">
                        @if(Model.Pagamentos.Count > 0)
                        {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <td></td>
                                    <td>@Html.DisplayNameFor(model => model.Pagamentos[0].UserName)</td>
                                    <td>@Html.DisplayNameFor(model => model.Pagamentos[0].Valor)</td>
                                    <td>@Html.DisplayNameFor(model => model.Pagamentos[0].DataPagamento)</td>
                                    <td class="hidden-xs">@Html.DisplayNameFor(model => model.Pagamentos[0].TipoPagamentoDescricao)</td>
                                    <td class="hidden-xs">@Html.DisplayNameFor(model => model.Pagamentos[0].Descricao)</td>
                                    <td></td>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int c = 0; c < Model.Pagamentos.Count; c++)
                                {

                                    <tr>
                                        <td>
                                            <img class="img-username" src="/Content/img/database/profiles/@(Model.Pagamentos[c].UserName).gif" />
                                        </td>
                                        <td>@Html.DisplayFor(model => model.Pagamentos[c].UserName)</td>
                                        <td>@Html.DisplayFor(model => model.Pagamentos[c].Valor)</td>
                                        <td>@Html.DisplayFor(model => model.Pagamentos[c].DataPagamento)</td>
                                        <td class="hidden-xs">@Html.DisplayFor(model => model.Pagamentos[c].TipoPagamentoDescricao)</td>
                                        <td class="hidden-xs">@Html.DisplayFor(model => model.Pagamentos[c].Descricao)</td>

                                        <td>

                                            @*<a href="@Url.Action("Edit", "Gerenciamento", new 
                                                {
                                                    dataPagamento = Model[c].DataPagamento,
                                                    nomeBolao = Model[c].NomeBolao,
                                                    userName = Model[c].UserName
                                                })">
                                                <span class="glyphicon glyphicon-edit fa-lg"></span>
                                            </a>
                                            |*@
                                            <a href="@Url.Action("Delete", "Gerenciamento", new
                                                {
                                                    dataPagamento = Model.Pagamentos[c].DataPagamento,
                                                    nomeBolao = Model.Pagamentos[c].NomeBolao,
                                                    userName = Model.Pagamentos[c].UserName
                                                })" onclick="return confirm('Deseja remover o pagamento selecionado?');">
                                                <span class="glyphicon glyphicon-remove fa-lg"></span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        }
                        else
                        {
                            <h3>Não foram encontrados pagamentos para este bolão</h3>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
@*</div>*@


 
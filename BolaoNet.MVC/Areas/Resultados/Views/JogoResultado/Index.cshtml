@model BolaoNet.MVC.ViewModels.Resultados.JogoResultadoViewModel
@{
    ViewBag.Title = "Jogo do Campeonato";
}
@using (Html.BeginForm("Salvar", "JogoResultado", FormMethod.Post, new { }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(x => x.NomeCampeonato)
    @Html.HiddenFor(x => x.JogoId)
    @Html.HiddenFor(x => x.IsDesempate)

    @*<div class="wrapper wrapper-content animated fadeInRight">*@
<div class="row">

    @*@if (!string.IsNullOrEmpty (Model.Mensagem))
        {
            <div class="col-lg-12">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h2>@Model.Mensagem</h2>
                    </div>
                </div>
            </div>
        }*@


    <div class="col-lg-8">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h3>Jogo</h3>
            </div>
            <div class="ibox-content" style="display: block;">

                <div class="row">
                    <div class="form-group col-md-6 col-sm-6">
                        <label>Fase:</label> @Model.NomeFase
                    </div>
                    <div class="form-group col-md-3 col-sm-3">
                        <label>Grupo:</label> @Model.NomeGrupo
                    </div>
                    <div class="form-group col-md-3 col-sm-3">
                        <label>Rodada:</label> @Model.Rodada
                    </div>
                </div>
                <div class="row text-center">
                    <div class="form-group col-md-2 col-sm-2">
                        <h3>
                            @Model.NomeTime1
                        </h3>
                    </div>
                    <div class="form-group col-md-1 col-sm-1 ">
                        <img class="img-time-resultado" src="@(Model.ImageTime1)" />
                    </div>
                    <div class="form-group col-md-2 col-sm-2">
                        @Html.TextBoxFor(x => x.GolsTime1, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.GolsTime1)
                    </div>
                    <div class="form-group col-md-1 col-sm-1 text-center">
                        x
                    </div>
                    <div class="form-group col-md-2 col-sm-2">
                        @Html.TextBoxFor(x => x.GolsTime2, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.GolsTime2)
                    </div>
                    <div class="form-group col-md-1 col-sm-1">
                        <img class="img-time-resultado" src="@(Model.ImageTime2)" />
                    </div>
                    <div class="form-group col-md-2 col-sm-2">
                        <h3>
                            @Model.NomeTime2
                        </h3>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12 text-center">
                        <label>Data do Jogo</label>
                    </div>
                    <div class="col-sm-12 text-center">
                        @Model.DataJogo
                    </div>
                </div>


                <div class="login-erro">
                    @Html.ValidationSummary(true)
                </div>
            </div>

        </div>
    </div>

    @if (Model.IsDesempate == true)
    {
        <div class="col-lg-4">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Penaltis</h5>
                </div>
                <div class="ibox-content" style="display: block;">
                    <div class="row text-center">
                        <div class="col-sm-3 col-xs-offset-1">
                            @Html.TextBoxFor(x => x.PenaltisTime1, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.PenaltisTime1)
                        </div>
                        <div class="col-sm-2 col-xs-offset-1 text-center">x</div>
                        <div class="col-sm-3 col-xs-offset-1">
                            @Html.TextBoxFor(x => x.PenaltisTime2, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.PenaltisTime2)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.IsValido)
    {
        <div class="col-lg-4">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Dados de Validação</h5>
                </div>
                <div class="ibox-content" style="display: block;">
                    <div class="row">
                        <div class="form-group col-md-6 col-sm-6">

                            @Html.Label("Validado por: ")
                            @Model.ValidadoBy


                        </div>

                        <div class="form-group col-md-6 col-sm-6">
                            <label>Data de Validação : </label>@Model.DataValidacao
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }


<div class="col-lg-3">
    <div class="ibox float-e-margins">

        <div class="ibox-title">
            <h5>Eventos da Partida @Model.ScoreHome x @Model.ScoreAway = @Model.Status</h5>
        </div>

        <div class="ibox-content"
             style="display:block; max-height:450px; overflow-y:auto; padding:8px;">

            @if (Model.Eventos != null && Model.Eventos.Any())
            {
                foreach (var evento in Model.Eventos)
                {
                    <div style="
                    display:flex;
                    align-items:center;
                    gap:8px;
                    width:100%;
                    padding:5px 0;
                    border-bottom:1px solid #f5f5f5;
                    font-size:12px;">

                        <div style="
                        width:55px;
                        text-align:center;
                        flex-shrink:0;">

                            @if (evento.EventType == "Início")
                            {
                                <span class="label label-default"
                                      style="display:inline-block; min-width:50px;">
                                    Início
                                </span>
                            }
                            else
                            {
                                <span class="label label-danger"
                                      style="display:inline-block; min-width:50px;">
                                       @(evento.Minute)@(evento.ExtraMinute != null && @evento.ExtraMinute != 0 ? "+" + evento.ExtraMinute : "")'
                                </span>
                            }

                        </div>

                        <div style="
                        flex:1;
                        display:flex;
                        justify-content:@(evento.IsHomeTeam ? "flex-start" : "flex-end");
                        overflow:hidden;">

                            @if (evento.EventType == "Início")
                            {
                                <strong>Início da partida</strong>
                            }
                            else
                            {
                                <div style="
                                max-width:100%;
                                overflow:hidden;
                                white-space:nowrap;
                                text-overflow:ellipsis;
                                text-align:@(evento.IsHomeTeam ? "left" : "right");">

                                    <strong>@evento.PlayerName</strong>

                                    @if (evento.IsOwnGoal)
                                    {
                                        <span class="text-danger">(contra)</span>
                                    }
                                    
                                    @if (evento.IsPenalty)
                                    {
                                        <span>(Penalty)</span>
                                    }
                                </div>
                            }

                        </div>

                        <div style="
                        width:70px;
                        text-align:right;
                        flex-shrink:0;
                        font-size:15px;
                        font-weight:bold;">

                            <span style="
                            color:@(evento.EventType != "Início" && evento.IsHomeTeam ? "#1ab394" : "#666");
                            font-weight:@(evento.EventType != "Início" && evento.IsHomeTeam ? "700" : "400");">

                                @evento.HomeScore

                            </span>

                            <span style="color:#999;"> x </span>

                            <span style="
                            color:@(evento.EventType != "Início" && !evento.IsHomeTeam ? "#1ab394" : "#666");
                            font-weight:@(evento.EventType != "Início" && !evento.IsHomeTeam ? "700" : "400");">

                                @evento.AwayScore

                            </span>

                        </div>

                    </div>
                }

            }
            else
            {
                <div class="text-center text-muted">
                    Nenhum evento encontrado.
                </div>
            }

        </div>
            @if (Model.EventosAtualizados == false)
            {

                <div class="row">
                    <div>
                        @Html.ActionLink(
                            "Salvar",
                            "SalvarEventos",
                            new
                            {
                                id = Model.JogoId
                            },
                            new
                            {
                                @class = "btn btn-xs btn-primary center-block"
                            })
                    </div>
                </div>

            }

    </div>


    </div>

    <div class="row">
        <div class="col-sm-offset-5 col-sm-2 text-center">
            <input type="submit" onclick="javascript:showWait();" class="btn btn-primary btn-lg center-block " value="Salvar" />
        </div>
    </div>


</div>




    @*</div>*@
}